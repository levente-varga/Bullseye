# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Worker only. Bypasses row-level security: never expose to the browser or Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic console → API keys (worker only)
ANTHROPIC_API_KEY=
# Optional fallback. The model is normally picked on the Criteria page (default claude-haiku-5-5).
SCORING_MODEL=
# Optional. Cap on LLM scoring calls per run (default 60).
MAX_SCORE_PER_RUN=

# Resend → API keys (worker only)
RESEND_API_KEY=
# Optional fallback recipient. Normally set in the dashboard (Criteria page).
# Without a verified domain, Resend only delivers to your own account email.
DIGEST_TO=
# Optional. Needs a verified domain in Resend; defaults to onboarding@resend.dev.
DIGEST_FROM=
# Optional. Where replies to Headshot emails go (the sending domain can't receive mail).
DIGEST_REPLY_TO=

# Optional. Your Vercel URL, linked from the emails.
APP_URL=
